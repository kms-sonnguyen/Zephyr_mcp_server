# Copy this file to ".env" in the same folder (next to SKILL.md) and fill in your values.
# Variables already set in your environment take precedence over this file.

# Required
ZEPHYR_BASE_URL=https://your-company.atlassian.net
ZEPHYR_API_KEY=your-zephyr-api-key

# Optional: "cloud" or "datacenter" (auto-detected from ZEPHYR_BASE_URL if blank)
JIRA_TYPE=

# Optional, Cloud EU region only
# ZEPHYR_API_BASE_URL=https://eu.api.zephyrscale.smartbear.com/v2

# Optional, Cloud only: needed to link Jira issues / bugs
# JIRA_USERNAME=you@company.com
# JIRA_API_TOKEN=your-jira-api-token
o